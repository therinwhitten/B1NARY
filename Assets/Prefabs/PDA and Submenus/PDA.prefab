--- !u!114 &6226354395435659187
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6813243050872810713}
  m_Enabled: 1
  m_EditorHideFlags: 0
