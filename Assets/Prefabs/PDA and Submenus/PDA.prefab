--- !u!114 &2260798295439991128
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6071307303789459764}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The better the tech, the longer a synthgen lasted before needing to be
    replaced. A sizable amount of streamers loved this tech. During sleeping-only
    streams, users would allow the synthgens to run the stream. \n\nIt wasn\u2019t
    just v-tubers. Live streamers could also make their own scans. \n\nCurrently
    the public is mixed about these changes, and it caused many conflicts inside
    their communities. \n\nCompanies used this side effect to their advantage; creating
    copies of popular influencers to sell their wares. At the start of the boom,
    it was mostly done illegally. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
