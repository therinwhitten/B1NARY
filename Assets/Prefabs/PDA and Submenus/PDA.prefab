  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This is his final project before he retires.\n\nSome whisper that Claire
    is attached to Cliff off the books, and will soon take over the lab for him.
    \n\nFinding out the connection might be useful. Maybe you should ask Shirobi?\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
