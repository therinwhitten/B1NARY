  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The name of this full setup? \n\nThe Dive.\n\nWith VR as it\u2019s main
    focus, sight, hearing, touch, smell, and taste were all there. It was muted compared
    to real life though. The reason for this was simple: the digital signals from
    the CPU chip don\u2019t translate as well to a bio signal.\n\nAs of 2040, over
    35 percent of the world\u2019s population has the Dead Man\u2019s Chip \u2018installed\u2019
    onto their foreheads. With Digital Horizon\u2019s 10 year almost flawless track
    record, many people trusts the company to find the best approach. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
