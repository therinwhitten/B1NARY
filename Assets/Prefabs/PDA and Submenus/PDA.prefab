--- !u!114 &5871372625242777042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 325870347668135296}
  m_Enabled: 1
  m_EditorHideFlags: 0
