--- !u!114 &7939218054710834477
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1149541515080464024}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Virtual Worlds finally had the proper hardware to take over the standard
    internet. \n\nThe adoption rate was insane: ticket sales for online concerts,
    backpacking trips to Mt Everest over the weekend, online college courses in the
    middle of a volcano\u2026\n\nCPU modules with different specs for different purposes
    were fabricated. Even the governments of the world made higher security versions
    to carry highly classified information. \n\nThe use of the human body as a battery
    had many novel uses outside of the virtual reality space. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
