  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Personality:   \r\nAsterella: Regal, quick to laugh, and slow to anger,
    Asterella is not what you would expect of a Demon Lord. She handles her responsibilities
    with an air of command and ease, but you see little sparks of childish indignation
    and wonder. Slightly Sadomasochistic, she has a tendancy to delve into some very
    dark humor at a moments notice. When you get her away from her minions and duties,
    she is almost a completely different person when she relaxes. She becomes a loving,
    deeply loyal, almost innocent person, new to the world. https://www.twitch.tv/asterellastar  
    \r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
