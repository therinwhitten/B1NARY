  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The strengths is the ability to understand context and adapt existing
    data to suit it\u2019s needs, like a human would. \n\nThese AI also can be programmed
    with a moral set of laws they would not break, or deem incredibly important.
    \n\nTack on the ability to learn from mistakes in real time, and you have the
    recipe for a human-like intelligence. \n\nThere is a ton of material on these
    concepts, but this is a visual novel. Plus, you just got into college. \L\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
