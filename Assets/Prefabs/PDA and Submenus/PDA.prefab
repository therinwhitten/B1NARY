  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the year 2030, Digital Horizons was founded. As a budding startup in
    the Virtual Reality space, they emerged onto the world stage showing off a new
    type of server; one that allows input for touch, haptics, and in the future,
    smell, and taste. \n\nThe server platform was built different. Efficient, stable,
    and easy to modify, they became the standard quickly. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
