  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Having a chip implanted on the outside of your skull in order to enjoy
    a movie in VR appears utterly ludicrous. \n\nMany parents were appalled. The
    number of old people yelling at the clouds increased with each passing year.
    \n\nThe applications of this new hardware in conjunction with Digital Horizon\u2019s
    new server tech dazzled the public. \n\nFrom things such as virtual surgery training,
    to live streaming redeems, to space walk education, the Dive locked itself in
    as the apex of spatial computing. \n\nAnd it happened quickly."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
