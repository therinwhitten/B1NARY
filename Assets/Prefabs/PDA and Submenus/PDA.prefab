  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Conversion to a digital signal caused a bit of interference and lowered
    the quality of the signals. Although these digital signals were miles ahead of
    any screen or headphones, the human brain can tell. \n\nThese \u2018flaws\u2019
    end up being a feature. \n\nThe brain can tell it\u2019s not real. If someone
    decided to do something questionable to you in the in the internet, it would\u2019t
    affect you as strongly. \n\nDigital Horizon considered the worst: torture using
    their products. \n\nThe Dive became the focus of both fascination, and apprehension. "
  m_isRightToLeft: 0
