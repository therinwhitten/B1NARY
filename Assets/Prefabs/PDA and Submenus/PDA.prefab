  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the real world, you are an intern for a prominent full dive company,
    Digital Horizons. \nYou\u2019re no one special: average grades in college, average
    to better than average looks, and a thirst for some good anime and manga. \nIn
    fact, you only jumped on this project to pay for your anime doll collection.
    Well, that, and some extra money for food. \nShirobi, your roommate at the dorms,
    talked you into it. \nThey made me sign a very sketchy NDA. I wonder what kind
    of tests they are conducting? \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
