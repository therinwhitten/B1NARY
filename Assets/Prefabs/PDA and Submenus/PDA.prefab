  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A lab tech working at Digital Horizons. He is bright, easy to talk to,
    and driven to unravel any mystery in the digital world, even at the cost of his
    own health. \n\nHe thoroughly considers every detail before he makes decisions.
    \n\nShirobi\u2019s friends mean a lot to him. He maintains social relationships
    almost religiously. \n\nHis work is his life though. Puzzles consume his curiosity
    until he solves them. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
