--- !u!114 &7067391036058743219
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 791577382435037915}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Using the Dead Man\u2019s Switch (See Digital Horizons or VR for more
    information), players can make \u201Cprofiles\u201D of their own brain to save
    into the CPU Module or upload into the internet to occupy their own space, labeled
    \u201Cdomains.\u201D (See Internet Theory)\n\nAt the very beginning, most of
    the time these were just residue from users spending too much time in the 3D
    space. The shadows would fade over a short period of time and vanish. \n\nResearchers
    are still actively searching for evidence, but the current theory states that
    the patterns degrade over time due to lack of cohesion. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
