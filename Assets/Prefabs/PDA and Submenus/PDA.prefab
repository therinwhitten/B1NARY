  m_GameObject: {fileID: 2775384486130403332}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Their streams are normally more set up to induce an emotional response.
    Good examples are horror games, heart beat streams, laugh or lose streams, etc.
    \n\nThe pattern some moderators have noted is the consistency of their emotional
    state when they are swamped with viewers: the more viewers that react to their
    content, the more often they stream, and for longer times. \n\nSome theories
    have floated from the bottom of the internet that these are in fact real demons
    siphoning off of the emotions the humans produce. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
