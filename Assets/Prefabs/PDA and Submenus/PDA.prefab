  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Blunt, yet polite, with waves of seething sarcasm leaking out. \n\nThe
    conductor of the Japan High Speed Rail high speed train that moves through the
    internet. \n\nAoi Miyuki is an AI designed by the Japan High Speed Rail  to comfort
    and socialize with the train\u2019s travelers. \n\nVerified sources on the internet
    believe she became \u2018sentient\u2019 in 2034. How did they know? \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
