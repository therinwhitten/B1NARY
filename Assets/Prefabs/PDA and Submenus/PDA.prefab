  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Domains are sections of servers that were introduced during the massive
    change of Digital Horizon\u2019s internet upgrades. \n\nDomains are localized
    areas of control for an individual user, or group. It\u2019s like a profile banner
    in a 3D space. \n\nThe idea went viral after a user changed the entire look of
    their section of the server with questionable memes about \u2018skibidi toilets\u2019
    and lewd copy pastas. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
