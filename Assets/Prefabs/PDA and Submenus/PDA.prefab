  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nThe framework that Digital Horizons designed and implemented was required
    for their next-gen computing. With their code no longer restricted by bandwidth
    issues, they could push the envelope of data far beyond what was once thought
    possible. \n\nSight, smell, touch, hearing, feeling. Websites no longer were
    a static page with fonts and colors as the only medium. A company could now make
    a 3D server world for their services at the same cost as a standard website.
    \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
