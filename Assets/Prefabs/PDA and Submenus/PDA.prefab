  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the real world, you are an aspiring Streamer, with ties at Digital
    Horizons. You are hoping that the experiments will open up new and exciting tech
    for the streaming community. \nWith curiosity driving you, nothing can stop you!
    The future awaits, and you are eager to be a pivotal part of it. \nYou are still
    scared, but the payoff is so much higher than the risks to you. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
