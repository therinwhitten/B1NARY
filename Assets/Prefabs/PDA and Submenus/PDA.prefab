--- !u!114 &1767802444084791857
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8822777072178910334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "They tend to degrade over time because of this (More on this phenomenon
    in the Other tab).\n\nNot only your consciousness, but the unconscious side of
    your mental state. Full copies don\u2019t seem to be possible. \n\nEven with
    the brain fully mapped, there are still areas of darkness. Researchers have dubbed
    these dark areas as the \u201CSoul.\u201D \n\nThe \u201CSoul\u201D cannot be
    copied. It can be moved though. \n\nAt least, theoretically. \n\nYou are the
    test subject, after all. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
  m_sharedMaterial: {fileID: 9137770337806101678, guid: 9476861b6a9cdca409e8769907d1a9d0,
    type: 2}
