  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Synthgens are clones of a person\u2019s brain patterns that remain in
    the internet: a shadow persona of the human it\u2019s copied from. \n\nFrom mannerisms,
    behavior, and even down to the self image, these synthgens might be able to fool
    other players that do not know the owner."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9476861b6a9cdca409e8769907d1a9d0, type: 2}
